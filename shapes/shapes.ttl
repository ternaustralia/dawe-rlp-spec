    <https://linked.data.gov.au/def/nrm/b23d0935-6d2c-4657-a416-1e9f61761bad>
     ;
            sosa:hasSimpleResult ?simple ;
            sosa:hasResult ?result .
        ?result rdf:value ?value .
        filter (?simple != ?value)
    }
    """
