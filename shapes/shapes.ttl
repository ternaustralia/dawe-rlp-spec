                sosa:hasResult ?this .
        }"""
        ] ;
    urnp:examples _:n0a3cdf418adc4754ab3ed234dc504aabb4434 ;
    urnp:query """
        PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
