    <https://linked.data.gov.au/def/nrm/02dbcc73-afc3-5425-80a2-eef898bddb67>
     ;
            sosa:hasSimpleResult ?simple ;
            sosa:hasResult ?result .
        ?result rdf:value ?value .
        filter (?simple != ?value)
