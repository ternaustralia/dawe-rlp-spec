    sh:message "The procedure's `tern:hasMethod` _MUST_ have the value `https://linked.data.gov.au/def/nrm/2084a9b6-2927-4651-bd88-781a01c38664`." ;
    sh:name "Method type of used procedure" ;
    sh:path tern:hasMethod ;
