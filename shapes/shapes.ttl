<urn:shapes:invertebrate-fauna-light-trapping-lepiled-protocol-shapes:weather-site-cloud-cover:feature-type>
    a
        sh:PropertyShape ,
        urnc:Requirement ;
    dcterms:source "TERN Ecosystem Surveillance Ecological Monitoring Protocols" ;
