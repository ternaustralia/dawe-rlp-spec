    <https://linked.data.gov.au/def/nrm/c45bcc9a-7d43-5665-a297-8c3815747aa6>
     ;
            sosa:hasSimpleResult ?simple ;
            sosa:hasResult ?result .
        ?result rdf:value ?value .
        filter (?simple != ?value)
    }
    """
        ] ;
