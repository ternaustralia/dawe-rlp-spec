    <https://linked.data.gov.au/def/nrm/f8d5c98b-ecee-5c56-9b95-a57280faec60>
     ;
            sosa:hasSimpleResult ?simple ;
            sosa:hasResult ?result .
        ?result rdf:value ?value .
        filter (?simple != ?value)
    }
    """
