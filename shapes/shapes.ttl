    <https://linked.data.gov.au/def/nrm/68d048e9-11f2-5c43-a27f-ae744b2c9799>
     ;
            sosa:hasSimpleResult ?simple ;
            sosa:hasResult ?result .
        ?result rdf:value ?value .
        filter (?simple != ?value)
