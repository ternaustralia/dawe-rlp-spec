            ?observation a tern:Observation ;
                sosa:observedProperty 
        <https://linked.data.gov.au/def/nrm/8886590d-f947-4504-aff7-3eec5db03c9d> ;
                sosa:hasResult ?this .
        }""" ;
        ] ;
