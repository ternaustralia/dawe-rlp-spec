    <https://linked.data.gov.au/def/nrm/57be29f6-1c6a-5c4d-89f2-00b21d4f4178>
     ;
            sosa:hasSimpleResult ?simple ;
            sosa:hasResult ?result .
        ?result rdf:value ?value .
        filter (?simple != ?value)
    }
    """ ;
        ] ;
