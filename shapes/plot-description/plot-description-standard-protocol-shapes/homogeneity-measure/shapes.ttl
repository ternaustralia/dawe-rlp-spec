<https://linked.data.gov.au/def/nrm/validator/shape/ba65a511-4bbd-4540-9f08-efb49b9c3de6>
    a
        sh:PropertyShape ,
        urnc:Requirement ;
    dcterms:source "Ecological Monitoring System - Australia Protocols" ;
    reg:status reg:statusSubmitted ;
    sh:description """IRI of method in procedure _MUST_ have the value `<https://linked.data.gov.au/def/nrm/615edd85-ea58-4d3c-b737-d31d8447ad49>`.

    # `<https://linked.data.gov.au/def/nrm/615edd85-ea58-4d3c-b737-d31d8447ad49>` is the IRI for "Standard Protocol".""" ;
    sh:hasValue <https://linked.data.gov.au/def/nrm/615edd85-ea58-4d3c-b737-d31d8447ad49> ;
    sh:message "The procedure's `tern:hasMethod` _MUST_ have the value `https://linked.data.gov.au/def/nrm/615edd85-ea58-4d3c-b737-d31d8447ad49`." ;
    sh:name "Method type of used procedure" ;
    sh:path tern:hasMethod ;
    sh:target [
            a sh:SPARQLTarget ;
            sh:select """
    PREFIX tern: <https://w3id.org/tern/ontologies/tern/>
    PREFIX unit: <http://qudt.org/vocab/unit/>
    PREFIX sosa: <http://www.w3.org/ns/sosa/>
    PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
    select ?this {
        values ?property_uri {<https://linked.data.gov.au/def/nrm/325d5ff2-8c81-484a-a422-c13ff29666a9>}
        ?observation a tern:Observation ;
            sosa:observedProperty ?property_uri ;
            sosa:usedProcedure ?this .
    }
    """
        ] ;
    urnp:examples _:nc0b1883f9f7e4b8db08f9b0b85c2798bb2 ;
    urnp:validator "https://github.com/ternaustralia/dawe-rlp-spec/blob/main/shapes/plot-description/plot-description-standard-protocol-shapes/homogeneity-measure/shapes.ttl"^^xsd:anyURI ;
.

