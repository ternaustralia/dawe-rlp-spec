<https://linked.data.gov.au/def/nrm/validator/shape/8d50097c-5e46-4f4f-b9a8-0170077ba152>
    a
        sh:PropertyShape ,
        urnc:Requirement ;
    dcterms:source "Ecological Monitoring System - Australia Protocols" ;
    reg:status reg:statusSubmitted ;
    sh:description """IRI of method in procedure _MUST_ have the value `<https://linked.data.gov.au/def/nrm/e0cb4c61-eaa4-4c57-b627-2061cc9311bd>`.

    `<https://linked.data.gov.au/def/nrm/e0cb4c61-eaa4-4c57-b627-2061cc9311bd>` is the IRI for "Within-plot Belt Transect Protocol".""" ;
    sh:hasValue <https://linked.data.gov.au/def/nrm/e0cb4c61-eaa4-4c57-b627-2061cc9311bd> ;
    sh:message "The procedure's `tern:hasMethod` _MUST_ have the value `https://linked.data.gov.au/def/nrm/e0cb4c61-eaa4-4c57-b627-2061cc9311bd`." ;
    sh:name "Method type of used procedure" ;
    sh:path tern:hasMethod ;
    sh:target [
            a sh:SPARQLTarget ;
            sh:select """
    PREFIX tern: <https://w3id.org/tern/ontologies/tern/>
    PREFIX unit: <http://qudt.org/vocab/unit/>
    PREFIX sosa: <http://www.w3.org/ns/sosa/>
    PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
    select ?this {
        values ?property_uri {<https://linked.data.gov.au/def/nrm/40631c45-30c6-5caa-afbc-221a3024f622>}
        ?observation a tern:Observation ;
            sosa:observedProperty ?property_uri ;
            sosa:usedProcedure ?this .
    }
    """
        ] ;
    urnp:examples _:n5b4fd158f8e74039b5822c2d4c279f69b2 ;
    urnp:validator "https://github.com/ternaustralia/dawe-rlp-spec/blob/main/shapes/herbivory-and-physical-damage/within-plot-belt-transect-protocol-shapes/foliage-damage-extent/shapes.ttl"^^xsd:anyURI ;
.

