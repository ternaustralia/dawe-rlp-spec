<https://linked.data.gov.au/def/nrm/validator/shape/fe01826d-c110-4192-b47b-aa5ecb51b215>
    a
        sh:NodeShape ,
        urnc:Requirement ;
    dcterms:source "Ecological Monitoring System - Australia Protocols" ;
