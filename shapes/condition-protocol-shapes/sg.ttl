    <https://linked.data.gov.au/def/nrm/0f2a866b-b54b-596a-9215-33fbf0e19b96>
     ;
            sosa:hasSimpleResult ?simple ;
            sosa:hasResult ?result .
        ?result rdf:value ?value .
        filter (?simple != ?value)
    }
    """ ;
        ] ;
