        ] ;
    urnp:examples _:n6a2d1fa3e9f44d299391e74f1318c4b9b2 ;
    urnp:validator "https://github.com/ternaustralia/dawe-rlp-spec/blob/main/shapes/condition-protocol-shapes/mistletoe-count-alive/shapes.ttl"^^xsd:anyURI ;
.

<https://linked.data.gov.au/def/nrm/validator/shape/b7eeb637-c67e-4aef-9d59-4dc79759fea0>
    a
        sh:PropertyShape ,
        urnc:Requirement ;
    dcterms:source "Ecological Monitoring System - Australia Protocols" ;
    reg:status reg:statusSubmitted ;
    sh:description """IRI of method in procedure _MUST_ have the value `<https://linked.data.gov.au/def/nrm/16a20c3f-e95d-4919-b2d1-a25c7a275109>`.

    `<https://linked.data.gov.au/def/nrm/16a20c3f-e95d-4919-b2d1-a25c7a275109>` is the IRI for "Condition Module".""" ;
    sh:hasValue <https://linked.data.gov.au/def/nrm/16a20c3f-e95d-4919-b2d1-a25c7a275109> ;
    sh:message "The procedure's `tern:hasMethod` _MUST_ have the value `https://linked.data.gov.au/def/nrm/16a20c3f-e95d-4919-b2d1-a25c7a275109`." ;
    sh:name "Method type of used procedure" ;
    sh:path tern:hasMethod ;
    sh:target [
            a sh:SPARQLTarget ;
            sh:select """
    PREFIX tern: <https://w3id.org/tern/ontologies/tern/>
    PREFIX unit: <http://qudt.org/vocab/unit/>
    PREFIX sosa: <http://www.w3.org/ns/sosa/>
    PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
    select ?this {
        values ?property_uri {<https://linked.data.gov.au/def/nrm/6a1d703f-6622-4804-8b78-4c2ac93c97ba>}
        ?observation a tern:Observation ;
            sosa:observedProperty ?property_uri ;
            sosa:usedProcedure ?this .
    }
    """
        ] ;
    urnp:examples _:n6a2d1fa3e9f44d299391e74f1318c4b9b2 ;
    urnp:validator "https://github.com/ternaustralia/dawe-rlp-spec/blob/main/shapes/condition-protocol-shapes/mistletoe-count-alive/shapes.ttl"^^xsd:anyURI ;
.

<https://linked.data.gov.au/def/nrm/validator/shape/2b78177a-065b-422b-b374-0829af3ecf3b>
    a
        sh:PropertyShape ,
        urnc:Requirement ;
    dcterms:source "Ecological Monitoring System - Australia Protocols" ;
    reg:status reg:statusSubmitted ;
    sh:datatype xsd:integer ;
    sh:description "Value _MUST_ be non-negative." ;
    sh:message "The result _MUST_ have a non-negative value." ;
    sh:minInclusive 0 ;
