    <https://linked.data.gov.au/def/nrm/0b7d0b62-93c9-5ee7-af45-b5dced4d6909>
     ;
            sosa:hasSimpleResult ?simple ;
            sosa:hasResult ?result .
        ?result rdf:value ?value .
        filter (?simple != ?value)
    }
    """
        ] ;
