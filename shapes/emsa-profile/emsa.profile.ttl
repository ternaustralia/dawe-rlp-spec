<https://linked.data.gov.au/def/nrm/profile/0702accb-e8b5-45bf-b2b9-25f235fa3546>
    a prof:Profile ;
    dcterms:created "2026-09-21"^^xsd:date ;
    dcterms:description "This is a profile declaration for the Ecological Monitoring System - Australia (EMSA) profile of the TERN Ontology. EMSA data is validated with the TERN Ontology shapes, the EMSA class-level shapes and the shapes of the survey protocol the data was collected under. The EMSA shapes restate a small number of TERN constraints so that they allow cases that are specific to EMSA, and add constraints that EMSA requires." ;
    dcterms:license "https://creativecommons.org/licenses/by/4.0/"^^xsd:anyURI ;
    dcterms:modified "2026-09-21"^^xsd:date ;
    dcterms:publisher <https://linked.data.gov.au/org/tern> ;
    dcterms:title "EMSA Profile" ;
    skos:scopeNote "The EMSA shapes are only correct when they are loaded together with the TERN Ontology shapes. Validating EMSA data against the TERN Ontology shapes alone reports the EMSA exceptions as errors. The protocol shapes use SHACL Advanced Features, so a validator must have those enabled, for example `advanced=True` in pySHACL." ;
    prof:hasResource
        <https://linked.data.gov.au/def/nrm/profile/resource/7c580192-aeac-4ca5-9ae5-a78d0e55aa6e> ,
        <https://linked.data.gov.au/def/nrm/profile/resource/9417c6be-5c8d-485b-9351-e3755604e332> ,
        <https://linked.data.gov.au/def/nrm/profile/resource/dd4dc506-f632-4e86-90dd-7648d82bd574> ;
    prof:isProfileOf <https://w3id.org/tern/profiles/tern> ;
.

<https://linked.data.gov.au/def/nrm/profile/resource/7c580192-aeac-4ca5-9ae5-a78d0e55aa6e>
    a prof:ResourceDescriptor ;
    dcterms:description "The EMSA protocol specification, which describes each survey protocol and the requirements its data must meet." ;
    dcterms:format "text/html" ;
    dcterms:title "EMSA - specification" ;
    prof:hasArtifact "https://ternaustralia.github.io/dawe-rlp-spec"^^xsd:anyURI ;
    prof:hasRole role:specification ;
.

