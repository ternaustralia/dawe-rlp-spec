    owl:imports <https://w3id.org/tern/shapes/tern.ttl> ;
    schema:creator <https://linked.data.gov.au/org/tern> ;
    schema:dateCreated "2026-09-21"^^xsd:date ;
    schema:description "Class-level shapes for the Ecological Monitoring System - Australia (EMSA). This shapes graph is a profile of the TERN Ontology shapes. It restates three TERN constraints so that they allow the cases that are specific to EMSA, adds the constraints EMSA requires on procedures, samples and material samples, and checks the format of WKT geometries. It must be loaded together with the TERN Ontology shapes and the EMSA protocol shapes." ;
    schema:name "EMSA Shapes Graph" ;
    schema:publisher <https://linked.data.gov.au/org/tern> ;
    schema:version "1" ;
