PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX dwc: <http://rs.tdwg.org/dwc/terms/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX tern: <https://w3id.org/tern/ontologies/tern/>
PREFIX tern-shapes: <https://w3id.org/tern/shapes/tern/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/def/nrm/validator/shape/0da38b7d-b232-4a23-a4b1-fcee0dd2a85b>
    a sh:NodeShape ;
    rdfs:label "Procedure" ;
    dcterms:source "Ecological Monitoring System - Australia Protocols" ;
    rdfs:isDefinedBy <https://linked.data.gov.au/def/nrm/validator/071e4963-3854-4da8-a50b-6304397f7f90> ;
    sh:description "EMSA records the method of a procedure with `tern:hasMethod`, so it is required here even though the TERN Ontology accepts either `tern:hasMethod` or `rdf:value`." ;
    sh:property
        <https://linked.data.gov.au/def/nrm/validator/shape/7e21d028-30e6-4725-b1a3-2af2e03cee80> ,
        <https://linked.data.gov.au/def/nrm/validator/shape/ea2d31df-2f98-44d6-90e2-e1b15eed9dd5> ;
    sh:targetClass tern:Procedure ;
.

<https://linked.data.gov.au/def/nrm/validator/shape/306129f1-8063-4da8-b9fc-d78d6aeca6fa>
    a sh:NodeShape ;
    rdfs:label "Observation collection" ;
    dcterms:source "Ecological Monitoring System - Australia Protocols" ;
    rdfs:isDefinedBy <https://linked.data.gov.au/def/nrm/validator/071e4963-3854-4da8-a50b-6304397f7f90> ;
    sh:description "Restates `tern-shapes:ObservationCollection-hasFeatureOfInterest`. The same Cover and Fire exception applies as for observations." ;
    sh:property <https://linked.data.gov.au/def/nrm/validator/shape/e696ad5d-c238-4225-95e8-4fa5d6ffc707> ;
    sh:sparql [
            a sh:SPARQLConstraint ;
            sh:message "A `tern:ObservationCollection` _MAY_ have a maximum of 1 `sosa:hasFeatureOfInterest` predicate, unless it was made under the Cover and Fire protocol." ;
            sh:select """
    PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
    PREFIX sosa: <http://www.w3.org/ns/sosa/>
    PREFIX tern: <https://w3id.org/tern/ontologies/tern/>
    select $this {
        $this sosa:hasFeatureOfInterest ?foi1, ?foi2 .
        filter (str(?foi1) < str(?foi2))
        filter not exists {
            {
                $this sosa:usedProcedure <https://linked.data.gov.au/def/nrm/91a54c7c-48ff-402d-a761-ed4fd4ad4a4b>
            } union {
                $this sosa:usedProcedure/tern:hasMethod <https://linked.data.gov.au/def/nrm/91a54c7c-48ff-402d-a761-ed4fd4ad4a4b>
            } union {
                $this sosa:usedProcedure/rdf:value <https://linked.data.gov.au/def/nrm/91a54c7c-48ff-402d-a761-ed4fd4ad4a4b>
            }
        }
    }
    """
        ] ;
    sh:targetClass tern:ObservationCollection ;
.

<https://linked.data.gov.au/def/nrm/validator/shape/5ef24986-2d3b-4f7a-a5c6-544254d38870>
    a sh:NodeShape ;
    rdfs:label "Material sample" ;
    dcterms:source "Ecological Monitoring System - Australia Protocols" ;
    rdfs:isDefinedBy <https://linked.data.gov.au/def/nrm/validator/071e4963-3854-4da8-a50b-6304397f7f90> ;
    sh:description "EMSA requires every material sample to carry exactly one Darwin Core material sample ID." ;
    sh:property <https://linked.data.gov.au/def/nrm/validator/shape/d06fd824-f55c-4f28-9504-45bcb61a086a> ;
    sh:targetClass tern:MaterialSample ;
.

<https://linked.data.gov.au/def/nrm/validator/shape/6843713d-e11b-4263-bc0e-6ebe3579b45c>
    a sh:NodeShape ;
    rdfs:label "Geometry" ;
    dcterms:source "Ecological Monitoring System - Australia Protocols" ;
    rdfs:isDefinedBy <https://linked.data.gov.au/def/nrm/validator/071e4963-3854-4da8-a50b-6304397f7f90> ;
    sh:description "Checks the format of WKT geometries: the datatype, and the form of POINT, LINESTRING and MULTIPOINT values, with longitude before latitude." ;
    sh:property <https://linked.data.gov.au/def/nrm/validator/shape/c74cd255-e114-48d3-8962-ee78f3f6a70b> ;
    sh:sparql
        [
            a sh:SPARQLConstraint ;
            sh:message "A POINT in `geo:asWKT` _MUST_ be written as `POINT (longitude latitude)`, with longitude before latitude." ;
            sh:select """
    PREFIX geo: <http://www.opengis.net/ont/geosparql#>
    SELECT $this ?value WHERE {
        $this geo:asWKT ?value .
        FILTER (REGEX(STR(?value), "^(<[^>]+>\\\\s+)?POINT"))
        FILTER (!REGEX(STR(?value), "^(<[^>]+>\\\\s+)?POINT\\\\s*\\\\(\\\\s*-?\\\\d+(\\\\.\\\\d+)?\\\\s+-?\\\\d+(\\\\.\\\\d+)?\\\\s*\\\\)$"))
    }
    """
        ] ,
        [
            a sh:SPARQLConstraint ;
            sh:message "A MULTIPOINT in `geo:asWKT` _MUST_ be written as `MULTIPOINT ((longitude1 latitude1), (longitude2 latitude2), ...)`, with longitude before latitude." ;
            sh:select """
    PREFIX geo: <http://www.opengis.net/ont/geosparql#>
    SELECT $this ?value WHERE {
        $this geo:asWKT ?value .
        FILTER (REGEX(STR(?value), "^(<[^>]+>\\\\s+)?MULTIPOINT"))
        FILTER (!REGEX(STR(?value), "^(<[^>]+>\\\\s+)?MULTIPOINT\\\\s*\\\\(\\\\s*(\\\\(\\\\s*-?\\\\d+(\\\\.\\\\d+)?\\\\s+-?\\\\d+(\\\\.\\\\d+)?\\\\s*\\\\)|-?\\\\d+(\\\\.\\\\d+)?\\\\s+-?\\\\d+(\\\\.\\\\d+)?)(\\\\s*,\\\\s*(\\\\(\\\\s*-?\\\\d+(\\\\.\\\\d+)?\\\\s+-?\\\\d+(\\\\.\\\\d+)?\\\\s*\\\\)|-?\\\\d+(\\\\.\\\\d+)?\\\\s+-?\\\\d+(\\\\.\\\\d+)?))*\\\\s*\\\\)$"))
    }
    """
        ] ,
        [
            a sh:SPARQLConstraint ;
            sh:message "A LINESTRING in `geo:asWKT` _MUST_ be written as `LINESTRING (longitude1 latitude1, longitude2 latitude2, ...)`, with longitude before latitude." ;
            sh:select """
    PREFIX geo: <http://www.opengis.net/ont/geosparql#>
    SELECT $this ?value WHERE {
        $this geo:asWKT ?value .
        FILTER (REGEX(STR(?value), "^(<[^>]+>\\\\s+)?LINESTRING"))
        FILTER (!REGEX(STR(?value), "^(<[^>]+>\\\\s+)?LINESTRING\\\\s*\\\\(\\\\s*-?\\\\d+(\\\\.\\\\d+)?\\\\s+-?\\\\d+(\\\\.\\\\d+)?(\\\\s*,\\\\s*-?\\\\d+(\\\\.\\\\d+)?\\\\s+-?\\\\d+(\\\\.\\\\d+)?)+\\\\s*\\\\)$"))
    }
    """
        ] ;
    sh:targetSubjectsOf geo:asWKT ;
.

<https://linked.data.gov.au/def/nrm/validator/shape/8f02510e-362d-4490-9519-192bb91cc68a>
    a sh:NodeShape ;
