            ]
            [
                sh:class tern:MaterialSample
            ]
            [
                sh:class tern:Site
            ]
            [
                sh:class tern:Transect
            ]
            [
                sh:class tern:System
            ]
            [
                sh:class tern:Sampler
            ]
        ) ;
    sh:path sosa:hasFeatureOfInterest ;
.

