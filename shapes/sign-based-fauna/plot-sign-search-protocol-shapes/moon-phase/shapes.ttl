        ?this a tern:Observation ;
            sosa:observedProperty ?property_uri .
    }
    """
        ] ;
    urnp:examples _:n1d27d4e7c8f147f796757e03c206da53b2 ;
    urnp:validator "https://github.com/ternaustralia/dawe-rlp-spec/blob/main/shapes/sign-based-fauna/plot-sign-search-protocol-shapes/moon-phase/shapes.ttl"^^xsd:anyURI ;
