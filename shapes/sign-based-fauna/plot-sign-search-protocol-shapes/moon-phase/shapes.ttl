<https://linked.data.gov.au/def/nrm/validator/shape/60a7e5c8-28e6-4a0b-b61a-86420cc94c2f>
    a
        sh:PropertyShape ,
        urnc:Requirement ;
    dcterms:source "Ecological Monitoring System - Australia Protocols" ;
    reg:status reg:statusSubmitted ;
    sh:description """IRI of method in procedure _MUST_ have the value `<https://linked.data.gov.au/def/nrm/7347c555-311b-49ed-8928-ab57880a6916>`.

    `<https://linked.data.gov.au/def/nrm/7347c555-311b-49ed-8928-ab57880a6916>` is the IRI for "Plot Sign Search Protocol".""" ;
    sh:hasValue <https://linked.data.gov.au/def/nrm/7347c555-311b-49ed-8928-ab57880a6916> ;
    sh:message "The procedure's `tern:hasMethod` _MUST_ have the value `https://linked.data.gov.au/def/nrm/7347c555-311b-49ed-8928-ab57880a6916`." ;
    sh:name "Method type of used procedure" ;
    sh:path tern:hasMethod ;
    sh:target [
            a sh:SPARQLTarget ;
            sh:select """
    PREFIX tern: <https://w3id.org/tern/ontologies/tern/>
    PREFIX unit: <http://qudt.org/vocab/unit/>
    PREFIX sosa: <http://www.w3.org/ns/sosa/>
    PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
    select ?this {
        values ?property_uri {<https://linked.data.gov.au/def/nrm/ec6a65f7-ff1a-5d00-a6e1-fa3af778aa74>}
        ?observation a tern:Observation ;
            sosa:observedProperty ?property_uri ;
            sosa:usedProcedure ?this .
    }
    """
        ] ;
    urnp:examples _:n1d27d4e7c8f147f796757e03c206da53b2 ;
    urnp:validator "https://github.com/ternaustralia/dawe-rlp-spec/blob/main/shapes/sign-based-fauna/plot-sign-search-protocol-shapes/moon-phase/shapes.ttl"^^xsd:anyURI ;
.

