<https://linked.data.gov.au/def/nrm/validator/shape/88cfbcdb-329b-4118-a963-95e2227025c3>
    a
        sh:PropertyShape ,
        urnc:Requirement ;
    dcterms:source "Ecological Monitoring System - Australia Protocols" ;
    reg:status reg:statusSubmitted ;
    sh:description """IRI of method in procedure _MUST_ have the value `<https://linked.data.gov.au/def/nrm/4307974a-f0ea-4d84-abee-de2451eac329>`.

    `<https://linked.data.gov.au/def/nrm/4307974a-f0ea-4d84-abee-de2451eac329>` is the IRI for "Within-plot Belt Transect Protocol".""" ;
    sh:hasValue <https://linked.data.gov.au/def/nrm/4307974a-f0ea-4d84-abee-de2451eac329> ;
    sh:message "The procedure's `tern:hasMethod` _MUST_ have the value `https://linked.data.gov.au/def/nrm/4307974a-f0ea-4d84-abee-de2451eac329`." ;
    sh:name "Method type of used procedure" ;
    sh:path tern:hasMethod ;
    sh:target [
            a sh:SPARQLTarget ;
            sh:select """
    PREFIX tern: <https://w3id.org/tern/ontologies/tern/>
    PREFIX unit: <http://qudt.org/vocab/unit/>
    PREFIX sosa: <http://www.w3.org/ns/sosa/>
    PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
    select ?this {
        values ?property_uri {<https://linked.data.gov.au/def/nrm/3fd81059-bf41-502d-9b4f-c32e81b8d869>}
        ?observation a tern:Observation ;
            sosa:observedProperty ?property_uri ;
            sosa:usedProcedure ?this .
    }
    """
        ] ;
    urnp:examples _:n908112f7abf24fd184bf1e6180f5af90b2 ;
    urnp:validator "https://github.com/ternaustralia/dawe-rlp-spec/blob/main/shapes/sign-based-fauna/within-plot-belt-transect-protocol-shapes/fauna-sign-type-count/shapes.ttl"^^xsd:anyURI ;
.

<https://linked.data.gov.au/def/nrm/validator/shape/ddb38f57-719f-4b1c-9c91-a71f07544a3e>
    a
        sh:PropertyShape ,
        urnc:Requirement ;
    dcterms:source "Ecological Monitoring System - Australia Protocols" ;
    reg:status reg:statusSubmitted ;
    sh:datatype xsd:integer ;
    sh:description "Value _MUST_ be positive." ;
