        select ?this  {
            ?observation a tern:Observation ;
                sosa:observedProperty 
        <https://linked.data.gov.au/def/nrm/3fd81059-bf41-502d-9b4f-c32e81b8d869> ;
                sosa:hasResult ?this .
        }"""
        ] ;
