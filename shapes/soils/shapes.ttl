    <https://linked.data.gov.au/def/nrm/92ae6036-50a8-446c-8df8-573860011b79>
     ;
            sosa:hasSimpleResult ?simple ;
            sosa:hasResult ?result .
        ?result rdf:value ?value .
        filter (?simple != ?value)
    }
    """
        ] ;
