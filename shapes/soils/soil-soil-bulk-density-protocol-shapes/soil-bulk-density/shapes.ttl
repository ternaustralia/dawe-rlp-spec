<https://linked.data.gov.au/def/nrm/validator/shape/70e5e1e2-8170-490c-8340-de7c9e24c44c>
    a
        sh:PropertyShape ,
        urnc:Requirement ;
    dcterms:source "Ecological Monitoring System - Australia Protocols" ;
    reg:status reg:statusSubmitted ;
    sh:description """IRI of method in procedure _MUST_ have the value `<https://linked.data.gov.au/def/nrm/d9e6739a-c2dd-4619-be43-1251449a6436>`.

    `<https://linked.data.gov.au/def/nrm/d9e6739a-c2dd-4619-be43-1251449a6436>` is the IRI for "Soil Bulk Density Protocol".""" ;
    sh:hasValue <https://linked.data.gov.au/def/nrm/d9e6739a-c2dd-4619-be43-1251449a6436> ;
    sh:message "The procedure's `tern:hasMethod` _MUST_ have the value `https://linked.data.gov.au/def/nrm/d9e6739a-c2dd-4619-be43-1251449a6436`." ;
    sh:name "Method type of used procedure" ;
    sh:path tern:hasMethod ;
    sh:target [
            a sh:SPARQLTarget ;
            sh:select """
    PREFIX tern: <https://w3id.org/tern/ontologies/tern/>
    PREFIX unit: <http://qudt.org/vocab/unit/>
    PREFIX sosa: <http://www.w3.org/ns/sosa/>
    PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
    select ?this {
        values ?property_uri {<https://linked.data.gov.au/def/nrm/ec510708-9ac1-4c8a-bfe2-31ba5bb693da>}
        ?observation a tern:Observation ;
            sosa:observedProperty ?property_uri ;
            sosa:usedProcedure ?this .
    }
    """
        ] ;
    urnp:examples _:nb8412b7c6d334e0a9d8407fa0e35c2e6b2 ;
    urnp:validator "https://github.com/ternaustralia/dawe-rlp-spec/blob/main/shapes/soils/soil-soil-bulk-density-protocol-shapes/soil-bulk-density/shapes.ttl"^^xsd:anyURI ;
.

