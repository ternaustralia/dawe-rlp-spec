    sosa:phenomenonTime <https://example.com/observation/micro-habitat-type/b91c54f2-9354-43ee-8412-09974fd2c23c/phenomenonTime> ;
    sosa:resultTime "2022-09-27T05:38:47.117000+00:00"^^xsd:dateTime ;
    sosa:usedProcedure <urn:test:procedure:invertebrate-fauna-active-sampling> ;
    tern:hasSiteVisit <urn:test:site> ;
.

