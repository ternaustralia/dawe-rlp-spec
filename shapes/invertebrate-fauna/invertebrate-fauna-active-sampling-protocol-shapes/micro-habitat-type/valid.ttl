            a tern:FeatureOfInterest ;
            void:inDataset <https://example.com/dataset/1> ;
            tern:featureType <http://linked.data.gov.au/def/tern-cv/2090cfd9-8b6b-497b-9512-497456a18b99>
        ] ;
    sosa:hasResult [
            a
                tern:IRI ,
                tern:Value ;
