PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX tern: <https://w3id.org/tern/ontologies/tern/>
PREFIX void: <http://rdfs.org/ns/void#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<urn:test:invertebrate-fauna-active-sampling-protocol-shapes:valid:host-species-name>
    a tern:Observation ;
    void:inDataset <https://example.com/dataset/1> ;
    rdfs:comment "Valid result for observable property - host species name" ;
    sosa:hasFeatureOfInterest [
            a tern:FeatureOfInterest ;
            void:inDataset <https://example.com/dataset/1> ;
            tern:featureType <http://linked.data.gov.au/def/tern-cv/2090cfd9-8b6b-497b-9512-497456a18b99>
        ] ;
    sosa:hasResult [
            a
                tern:Text ,
                tern:Value ;
            rdf:value "Eucalyptus globulus"^^xsd:string ;
            sosa:isResultOf <urn:test:invertebrate-fauna-active-sampling-protocol-shapes:valid:host-species-name>
        ] ;
    sosa:hasSimpleResult "Eucalyptus globulus"^^xsd:string ;
    sosa:observedProperty <https://linked.data.gov.au/def/nrm/455d3f64-0523-5202-8db4-4775e8dff114> ;
    sosa:phenomenonTime <https://example.com/observation/host-species-name/b91c54f2-9354-43ee-8412-09974fd2c23c/phenomenonTime> ;
    sosa:resultTime "2022-09-27T05:38:47.117000+00:00"^^xsd:dateTime ;
    sosa:usedProcedure <urn:test:procedure:invertebrate-fauna-active-sampling> ;
    tern:hasSiteVisit <urn:test:site> ;
.

<urn:test:procedure:invertebrate-fauna-active-sampling>
    a tern:Procedure ;
    tern:methodType <https://linked.data.gov.au/def/nrm/e76e99ef-de1d-4387-9b2e-3455b9f9ff78> ;
.

