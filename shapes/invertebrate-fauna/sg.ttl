    select $this {
        $this a tern:Observation ;
            sosa:observedProperty 
    <https://linked.data.gov.au/def/nrm/25d4c7b7-4cdf-4b69-8774-064055c74e23>
     ;
            sosa:hasSimpleResult ?simple ;
