        <https://linked.data.gov.au/def/nrm/f77ad4ac-ecde-5bcc-b6be-833bb1e57f94>
    ) ;
    sh:message "The value of `rdf:value` _MUST_ exist in the rainfall duration types controlled vocabulary." ;
