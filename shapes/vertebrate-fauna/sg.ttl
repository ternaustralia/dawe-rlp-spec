    <https://linked.data.gov.au/def/nrm/ac5a20c2-64f7-5335-b080-a6aacb92e5d8>
     ;
            sosa:hasSimpleResult ?simple ;
            sosa:hasResult ?result .
        ?result rdf:value ?value .
        filter (?simple != ?value)
    }
    """ ;
        ] ;
