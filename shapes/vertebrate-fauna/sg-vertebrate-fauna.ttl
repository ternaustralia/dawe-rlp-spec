    sh:in (
        <https://linked.data.gov.au/def/nrm/a96d7507-e823-5f3a-a26b-62313538e0bb>
        <https://linked.data.gov.au/def/nrm/7230bbb8-9f03-5dd0-9ecf-fddfe4bb3c7c>
