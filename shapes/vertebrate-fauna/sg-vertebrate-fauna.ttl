<urn:shapes:vertebrate-fauna-identify-measure-and-release-protocol-shapes:clinical-scoring-chemosis-of-eyes:result-value>
    a
        sh:PropertyShape ,
        urnc:Controlled ,
        urnc:Requirement ;
    dcterms:source "Ecological Monitoring System - Australia Protocols" ;
    reg:status reg:statusSubmitted ;
    rdfs:isDefinedBy <urn:edes:shapes:vertebrate-fauna> ;
    sh:description "The value in `sosa:hasResult` _MUST_ be a value in `sh:in`, which is the Severity classes of chemosis of eyes controlled vocabulary." ;
