<urn:shapes:vertebrate-fauna-identify-measure-and-release-protocol-shapes:testes-size:result-value>
    a
        sh:PropertyShape ,
        urnc:Controlled ,
        urnc:Requirement ;
    dcterms:source "Ecological Monitoring System - Australia Protocols" ;
    reg:status reg:statusSubmitted ;
    rdfs:isDefinedBy <urn:edes:shapes:vertebrate-fauna> ;
