                sosa:observedProperty 
        <https://linked.data.gov.au/def/nrm/ec6a65f7-ff1a-5d00-a6e1-fa3af778aa74> ;
                sosa:hasResult ?this .
        }""" ;
        ] ;
    urnp:examples _:n7be3ab70581649578a75cdc920c0aa15b1006 ;
    urnp:query """
        PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
        select ?values {
            values ?categoricalUUID {'30688460-6aaa-53aa-94e7-be1164f5343b'}
            ?s skos:member ?values .
            filter (STRENDS(str(?s), ?categoricalUUID))
        }
        """ ;
    urnp:sparqlEndpoint "https://graphdb.tern.org.au/repositories/dawe_vocabs_core" ;
    urnp:validator "https://github.com/ternaustralia/dawe-rlp-spec/blob/main/shapes/vertebrate-fauna/vertebrate-fauna-active-and-passive-searching-protocol-shapes/moon-phase/shapes.ttl"^^xsd:anyURI ;
