<urn:shapes:vertebrate-fauna-acoustic-and-ultrasonic-recording-protocol-shapes:land-use-history:used-procedure>
    a
        sh:PropertyShape ,
        urnc:Requirement ;
    dcterms:source "Ecological Monitoring System - Australia Protocols" ;
    reg:status reg:statusSubmitted ;
    rdfs:isDefinedBy <urn:edes:shapes:vertebrate-fauna> ;
    sh:description """IRI of method in procedure _MUST_ have the value `<https://linked.data.gov.au/def/nrm/a15130ca-82ce-4c50-9392-66f9b0c73450>`.

    # `<https://linked.data.gov.au/def/nrm/a15130ca-82ce-4c50-9392-66f9b0c73450>` is the IRI for "Acoustics and Ultrasound Protocol".""" ;
    sh:hasValue <https://linked.data.gov.au/def/nrm/a15130ca-82ce-4c50-9392-66f9b0c73450> ;
    sh:message "The procedure's `tern:hasMethod` _MUST_ have the value `https://linked.data.gov.au/def/nrm/a15130ca-82ce-4c50-9392-66f9b0c73450`." ;
    sh:name "Method type of used procedure" ;
    sh:path tern:hasMethod ;
    sh:target
        [
            a sh:SPARQLTarget ;
            sh:select """
    PREFIX tern: <https://w3id.org/tern/ontologies/tern/>
    PREFIX unit: <http://qudt.org/vocab/unit/>
    PREFIX sosa: <http://www.w3.org/ns/sosa/>
    PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
    select ?this {
        values ?property_uri {<https://linked.data.gov.au/def/nrm/372ec5c5-79da-44a9-a56e-dd9ab311da06>}
        ?observation a tern:Observation ;
            sosa:observedProperty ?property_uri ;
            sosa:usedProcedure ?this .
    }
    """ ;
        ] ;
    urnp:examples _:n7be3ab70581649578a75cdc920c0aa15b59 ;
    urnp:validator "https://github.com/ternaustralia/dawe-rlp-spec/blob/main/shapes/plot-description/vertebrate-fauna-acoustic-and-ultrasonic-recording-protocol-shapes/land-use-history/shapes.ttl"^^xsd:anyURI ;
