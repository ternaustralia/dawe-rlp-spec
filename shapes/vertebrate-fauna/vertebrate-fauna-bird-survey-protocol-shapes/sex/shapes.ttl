<https://linked.data.gov.au/def/nrm/validator/shape/f27a8446-c9d5-47dc-9ba3-d07da96e00e4>
    a
        sh:PropertyShape ,
        urnc:Requirement ;
    dcterms:source "Ecological Monitoring System - Australia Protocols" ;
    reg:status reg:statusSubmitted ;
    sh:description """IRI of method in procedure _MUST_ have the value `<https://linked.data.gov.au/def/nrm/98db8232-2c51-4907-99a7-0ccb8b825382>`.

    `<https://linked.data.gov.au/def/nrm/98db8232-2c51-4907-99a7-0ccb8b825382>` is the IRI for "Bird Survey Protocol".""" ;
