    sh:message "The procedure's `tern:methodType` _MUST_ have the value `https://linked.data.gov.au/def/nrm/98db8232-2c51-4907-99a7-0ccb8b825382`." ;
    sh:name "Method type of used procedure" ;
    sh:path tern:methodType ;
    sh:target [
            a sh:SPARQLTarget ;
            sh:select """
