<urn:fake:procedure>
    a tern:Procedure ;
    tern:methodType <urn:fake:method> ;
.

<urn:test:vertebrate-fauna-acoustic-and-ultrasonic-recording-protocol-shapes:invalid:dominant-overstorey-plant-species:datatype>
    a tern:Observation ;
    void:inDataset <https://example.com/dataset/1> ;
    rdfs:comment "Invalid result - the datatype of the value of the result node must be `xsd:string`." ;
    sosa:hasFeatureOfInterest [
            a tern:FeatureOfInterest ;
            void:inDataset <https://example.com/dataset/1> ;
            tern:featureType <http://linked.data.gov.au/def/tern-cv/b311c0d3-4a1a-4932-a39c-f5cdc1afa611>
        ] ;
    sosa:hasResult [
            a
                tern:Text ,
                tern:Value ;
            rdf:value 1 ;
            sosa:isResultOf <urn:test:vertebrate-fauna-acoustic-and-ultrasonic-recording-protocol-shapes:invalid:dominant-overstorey-plant-species:datatype>
        ] ;
    sosa:hasSimpleResult 1 ;
    sosa:observedProperty <https://linked.data.gov.au/def/nrm/5b60730b-d6e1-4339-90c0-8e740230f9ae> ;
    sosa:phenomenonTime <https://example.com/observation/dominant-overstorey-plant-species/b91c54f2-9354-43ee-8412-09974fd2c23c/phenomenonTime> ;
    sosa:resultTime "2022-09-27T05:38:47.117000+00:00"^^xsd:dateTime ;
    sosa:usedProcedure <urn:test:procedure:vertebrate-fauna-acoustic-and-ultrasonic-recording> ;
    tern:hasSiteVisit <urn:test:site> ;
.

