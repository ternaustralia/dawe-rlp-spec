PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX tern: <https://w3id.org/tern/ontologies/tern/>
PREFIX void: <http://rdfs.org/ns/void#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<urn:test:procedure:vertebrate-fauna-acoustic-and-ultrasonic-recording>
    a tern:Procedure ;
    tern:methodType <https://linked.data.gov.au/def/nrm/a15130ca-82ce-4c50-9392-66f9b0c73450> ;
.

<urn:test:vertebrate-fauna-acoustic-and-ultrasonic-recording-protocol-shapes:valid:dominant-overstorey-plant-species>
    a tern:Observation ;
    void:inDataset <https://example.com/dataset/1> ;
    rdfs:comment "Valid result for observable property - dominant overstorey plant species" ;
    sosa:hasFeatureOfInterest [
            a tern:FeatureOfInterest ;
            void:inDataset <https://example.com/dataset/1> ;
            tern:featureType <http://linked.data.gov.au/def/tern-cv/b311c0d3-4a1a-4932-a39c-f5cdc1afa611>
        ] ;
    sosa:hasResult [
            a
                tern:Text ,
                tern:Value ;
            rdf:value "Eucalyptus tereticornis"^^xsd:string ;
            sosa:isResultOf <urn:test:vertebrate-fauna-acoustic-and-ultrasonic-recording-protocol-shapes:valid:dominant-overstorey-plant-species>
        ] ;
    sosa:hasSimpleResult "Eucalyptus tereticornis"^^xsd:string ;
    sosa:observedProperty <https://linked.data.gov.au/def/nrm/5b60730b-d6e1-4339-90c0-8e740230f9ae> ;
    sosa:phenomenonTime <https://example.com/observation/dominant-overstorey-plant-species/b91c54f2-9354-43ee-8412-09974fd2c23c/phenomenonTime> ;
    sosa:resultTime "2022-09-27T05:38:47.117000+00:00"^^xsd:dateTime ;
    sosa:usedProcedure <urn:test:procedure:vertebrate-fauna-acoustic-and-ultrasonic-recording> ;
    tern:hasSiteVisit <urn:test:site> ;
.

