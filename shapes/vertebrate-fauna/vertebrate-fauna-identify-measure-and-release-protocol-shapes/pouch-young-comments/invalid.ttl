<urn:test:vertebrate-fauna-identify-measure-and-release-protocol-shapes:invalid:pouch-young-comments:datatype>
    a tern:Observation ;
    void:inDataset <https://example.com/dataset/1> ;
    rdfs:comment "Invalid result - the datatype of the value of the result node must be `xsd:string`." ;
    sosa:hasFeatureOfInterest [
            a tern:FeatureOfInterest ;
            void:inDataset <https://example.com/dataset/1> ;
            tern:featureType <http://linked.data.gov.au/def/tern-cv/2361dea8-598c-4b6f-a641-2b98ff199e9e>
        ] ;
    sosa:hasResult [
            a
                tern:Text ,
                tern:Value ;
            rdf:value 1 ;
            sosa:isResultOf <urn:test:vertebrate-fauna-identify-measure-and-release-protocol-shapes:invalid:pouch-young-comments:datatype>
        ] ;
    sosa:hasSimpleResult 1 ;
    sosa:observedProperty <https://linked.data.gov.au/def/nrm/3600234c-2736-564d-ac18-ba24a13abea8> ;
    sosa:phenomenonTime <https://example.com/observation/pouch-young-comments/b91c54f2-9354-43ee-8412-09974fd2c23c/phenomenonTime> ;
    sosa:resultTime "2022-09-27T05:38:47.117000+00:00"^^xsd:dateTime ;
    sosa:usedProcedure <urn:test:procedure:vertebrate-fauna-identify-measure-and-release> ;
    tern:hasSiteVisit <urn:test:site> ;
.

