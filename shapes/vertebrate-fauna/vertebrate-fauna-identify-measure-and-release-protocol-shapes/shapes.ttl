    <https://linked.data.gov.au/def/nrm/13d9b6a3-f600-50ee-a8a7-f31b5b27abff>
     ;
            sosa:hasSimpleResult ?simple ;
            sosa:hasResult ?result .
        ?result rdf:value ?value .
        filter (?simple != ?value)
    }
    """
        ] ;
