<https://linked.data.gov.au/def/nrm/validator/shape/14e3f59e-5940-4974-b5c3-0259fe3845fa>
    a
        sh:PropertyShape ,
        urnc:Requirement ;
    dcterms:source "Ecological Monitoring System - Australia Protocols" ;
    reg:status reg:statusSubmitted ;
    sh:description """IRI of method in procedure _MUST_ have the value `<https://linked.data.gov.au/def/nrm/7942c1d3-8cfc-4d74-931d-850cacfa5a63>`.

    `<https://linked.data.gov.au/def/nrm/7942c1d3-8cfc-4d74-931d-850cacfa5a63>` is the IRI for "Identify, Measure and Release Protocol".""" ;
    sh:hasValue <https://linked.data.gov.au/def/nrm/7942c1d3-8cfc-4d74-931d-850cacfa5a63> ;
    sh:message "The procedure's `tern:methodType` _MUST_ have the value `https://linked.data.gov.au/def/nrm/7942c1d3-8cfc-4d74-931d-850cacfa5a63`." ;
    sh:name "Method type of used procedure" ;
    sh:path tern:methodType ;
    sh:target [
            a sh:SPARQLTarget ;
            sh:select """
    PREFIX tern: <https://w3id.org/tern/ontologies/tern/>
    PREFIX unit: <http://qudt.org/vocab/unit/>
    PREFIX sosa: <http://www.w3.org/ns/sosa/>
    PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
    select ?this {
        values ?property_uri {<https://linked.data.gov.au/def/nrm/f16897cb-7775-55fb-9ba4-3239b2927260>}
        ?observation a tern:Observation ;
            sosa:observedProperty ?property_uri ;
            sosa:usedProcedure ?this .
    }
    """
        ] ;
    urnp:examples _:nc0ad97122608475ca89224e40d9d6a60b2 ;
    urnp:validator "https://github.com/ternaustralia/dawe-rlp-spec/blob/main/shapes/vertebrate-fauna/vertebrate-fauna-identify-measure-and-release-protocol-shapes/tibia-length/shapes.ttl"^^xsd:anyURI ;
.

