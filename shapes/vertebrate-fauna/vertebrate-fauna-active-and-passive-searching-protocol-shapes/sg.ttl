    <https://linked.data.gov.au/def/nrm/ab6c601a-49a2-5287-8d7b-164ff8cdc791>
     ;
            sosa:hasSimpleResult ?simple ;
            sosa:hasResult ?result .
        ?result rdf:value ?value .
        filter (?simple != ?value)
    }
    """ ;
        ] ;
