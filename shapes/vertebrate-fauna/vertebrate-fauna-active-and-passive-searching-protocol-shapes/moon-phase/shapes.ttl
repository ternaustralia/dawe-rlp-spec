    urnp:examples _:n990f5cbf0f6b45e49d851aeaeceddb9ab2 ;
    urnp:validator "https://github.com/ternaustralia/dawe-rlp-spec/blob/main/shapes/vertebrate-fauna/vertebrate-fauna-active-and-passive-searching-protocol-shapes/moon-phase/shapes.ttl"^^xsd:anyURI ;
